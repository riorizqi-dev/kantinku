# ============================================================
# KantinKu — Environment Variables
# Lokal: copy ke .env.local
# Vercel: Project Settings → Environment Variables
# ============================================================

# URL publik app
# Lokal:  http://localhost:3000
# Vercel: https://your-app.vercel.app  (WAJIB diganti setelah deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://poktqbojdfwxuepxvipk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# WarungErik Pay (QRIS) — WAJIB untuk pembayaran online
# Portal API: https://pg.warungerik.com/api-docs
# Daftar API key: login pg.warungerik.com → dashboard → API
# ------------------------------------------------------------
WARUNGERIK_API_KEY=
WARUNGERIK_BASE_URL=https://pg.warungerik.com

# Nomor WA PENJUAL/kantin (tujuan chat customer → penjual)
# Format internasional tanpa +: 62812xxxxxxx
# Bisa juga diisi lewat Dashboard Penjual → Pengaturan
# NEXT_PUBLIC_SELLER_WHATSAPP=6281234567890

# Fallback browser (opsional lokal). Di Vercel cukup WARUNGERIK_API_KEY server.
# NEXT_PUBLIC_WARUNGERIK_API_KEY=
# NEXT_PUBLIC_WARUNGERIK_BASE_URL=https://pg.warungerik.com
