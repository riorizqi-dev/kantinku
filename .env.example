# ============================================================
# KantinKu — Environment Variables
# Lokal: copy ke .env.local
# Vercel: Project Settings → Environment Variables
# ============================================================

# URL publik app
# Lokal:  http://localhost:3000
# Vercel: https://your-app.vercel.app  (WAJIB diganti setelah deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase
# Dashboard → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://poktqbojdfwxuepxvipk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Bayar.gg (QRIS) — WAJIB untuk pembayaran online
# Dashboard: https://www.bayar.gg
# ------------------------------------------------------------
BAYAR_API_KEY=
BAYAR_BASE_URL=https://www.bayar.gg/api
BAYAR_PAYMENT_METHOD=qris
# Checkout URL aktif di dashboard Bayar.gg (default hosted pay page)
BAYAR_PAYMENT_URL=https://www.bayar.gg/pay
BAYAR_USE_QRIS_CONVERTER=true

# Opsional webhook
# BAYAR_WEBHOOK_SECRET=

# HANYA lokal Windows kalau DNS Node error (JANGAN set di Vercel)
# BAYAR_FORCE_IP=95.169.180.225

# Nomor WA PENJUAL/kantin (tujuan chat customer → penjual)
# Format internasional tanpa +: 62812xxxxxxx
# Bisa juga diisi lewat Dashboard Penjual → Pengaturan
# NEXT_PUBLIC_SELLER_WHATSAPP=6281234567890

# Fallback browser (opsional lokal). Di Vercel cukup BAYAR_API_KEY server.
# NEXT_PUBLIC_BAYAR_API_KEY=
# NEXT_PUBLIC_BAYAR_BASE_URL=https://www.bayar.gg/api
